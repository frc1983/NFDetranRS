Options -Indexes -MultiViews
RewriteEngine On

# Public assets remain in web/, while the visible URL stays /NFDetranRS/.
RewriteRule ^(css|js|assets)/(.*)$ web/$1/$2 [END]

# Every application route is handled by the root front controller.
# Existing project files are intentionally not exposed by Apache.
RewriteRule ^index\.php$ - [END]
RewriteRule ^.*$ index.php [END,QSA]
